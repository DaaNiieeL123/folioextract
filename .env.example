# Frontend
# Base URL consumed by frontend API client.
# If omitted, frontend defaults to http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Backend (runtime command example)
# These values are consumed by uvicorn command flags.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Optional runtime data directory for settings, logs and job history.
# If omitted, FolioExtract uses ~/.folioextract or a platform-local fallback.
FOLIOEXTRACT_HOME=
